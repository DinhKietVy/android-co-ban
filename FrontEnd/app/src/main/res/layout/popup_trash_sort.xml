<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="260dp"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@android:color/white"
    app:cardCornerRadius="16dp"
    app:cardElevation="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="16dp"
        android:paddingBottom="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginBottom="12dp"
            android:letterSpacing="0.05"
            android:text="SORT BY"
            android:textColor="#8F929C"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Date Deleted -->
        <LinearLayout
            android:id="@+id/menuSortDate"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <ImageView
                android:id="@+id/iconSortDate"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/calendar"
                android:tint="#0D6EFD" />

            <TextView
                android:id="@+id/textSortDate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:text="Date deleted"
                android:textColor="#0D6EFD"
                android:textSize="16sp" />

            <ImageView
                android:id="@+id/indicatorSortDate"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginStart="8dp"
                android:src="@drawable/arrow_down_a_z"
                android:tint="#0D6EFD"
                android:visibility="invisible" />
        </LinearLayout>

        <!-- Name -->
        <LinearLayout
            android:id="@+id/menuSortName"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <ImageView
                android:id="@+id/iconSortName"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_type"
                android:tint="#374151" />

            <TextView
                android:id="@+id/textSortName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:text="Name"
                android:textColor="#111827"
                android:textSize="16sp" />

            <ImageView
                android:id="@+id/indicatorSortName"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginStart="8dp"
                android:src="@drawable/arrow_down_a_z"
                android:tint="#0D6EFD"
                android:visibility="invisible" />
        </LinearLayout>

        <!-- File size -->
        <LinearLayout
            android:id="@+id/menuSortSize"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <ImageView
                android:id="@+id/iconSortSize"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/hard_drive"
                android:tint="#374151" />

            <TextView
                android:id="@+id/textSortSize"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:text="File size"
                android:textColor="#111827"
                android:textSize="16sp" />

            <ImageView
                android:id="@+id/indicatorSortSize"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginStart="8dp"
                android:src="@drawable/arrow_down_a_z"
                android:tint="#0D6EFD"
                android:visibility="invisible" />
        </LinearLayout>

        <!-- Days until removal -->
        <LinearLayout
            android:id="@+id/menuSortDaysLeft"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <ImageView
                android:id="@+id/iconSortDaysLeft"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/clock"
                android:tint="#374151" />

            <TextView
                android:id="@+id/textSortDaysLeft"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:text="Days until removal"
                android:textColor="#111827"
                android:textSize="16sp" />

            <ImageView
                android:id="@+id/indicatorSortDaysLeft"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginStart="8dp"
                android:src="@drawable/arrow_down_a_z"
                android:tint="#0D6EFD"
                android:visibility="invisible" />
        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>
