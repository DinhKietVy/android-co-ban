<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="96dp"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="12dp"
    android:paddingBottom="12dp">

    <CheckBox
        android:id="@+id/itemSelectionCheckBox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/thumbContainer"
        android:layout_width="48dp"
        android:layout_height="48dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/filePreviewImage"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/explorer_file_icon"
            android:scaleType="centerCrop"
            android:src="@drawable/explorer_file_preview_placeholder"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Explorer.FilePreview" />

        <ImageView
            android:id="@+id/fileFallbackIcon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:contentDescription="@string/explorer_file_icon"
            android:src="@drawable/file_text"
            android:tint="@color/explorer_primary"
            tools:visibility="visible" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/itemNameText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/explorer_text_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="Invoice_2026.pdf" />

            <ImageView
                android:id="@+id/aiBadgeIcon"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginStart="6dp"
                android:src="@drawable/sparkles"
                android:tint="@color/explorer_primary"
                android:visibility="gone"
                tools:visibility="visible" />

            <ImageView
                android:id="@+id/favoriteBadgeIcon"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginStart="6dp"
                android:src="@drawable/star"
                android:tint="@color/amber_600"
                android:visibility="gone"
                tools:visibility="visible" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tagContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/ocrPreviewText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/explorer_tag_background"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingStart="8dp"
            android:paddingTop="4dp"
            android:paddingEnd="8dp"
            android:paddingBottom="4dp"
            android:textColor="@color/explorer_text_secondary"
            android:textSize="11sp"
            android:visibility="gone"
            tools:text="Amazon.com Order #123-4567890-123..."
            tools:visibility="visible" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/itemMetaText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/explorer_text_secondary"
                android:textSize="12sp"
                tools:text="245 KB" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="6dp"
                android:text="@string/explorer_dot_separator"
                android:textColor="@color/explorer_text_secondary"
                android:textSize="12sp" />

            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/calendar"
                android:tint="@color/explorer_text_secondary" />

            <TextView
                android:id="@+id/itemDateText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:textColor="@color/explorer_text_secondary"
                android:textSize="12sp"
                tools:text="May 19, 2026" />
        </LinearLayout>
    </LinearLayout>

    <ImageButton
        android:id="@+id/moreButton"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/explorer_more"
        android:padding="8dp"
        android:src="@drawable/more_vertical"
        android:tint="@color/explorer_text_secondary" />

</LinearLayout>
