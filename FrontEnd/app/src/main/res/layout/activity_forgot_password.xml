<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/forgot_background"
    tools:context=".password.ForgotPasswordActivity">

    <View
        android:layout_width="260dp"
        android:layout_height="260dp"
        android:alpha="0.9"
        android:background="@drawable/forgot_blob_blue"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:translationX="-88dp"
        android:translationY="-52dp" />

    <View
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:alpha="0.9"
        android:background="@drawable/forgot_blob_purple"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:translationX="52dp"
        android:translationY="42dp" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/phoneCard"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="18dp"
        app:cardBackgroundColor="@color/forgot_screen_bg"
        app:cardCornerRadius="32dp"
        app:cardElevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="18dp"
                android:paddingEnd="20dp"
                android:paddingBottom="20dp">

                <ImageButton
                    android:id="@+id/topBackButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/forgot_back_button_bg"
                    android:contentDescription="@string/forgot_back_to_login"
                    android:padding="8dp"
                    android:src="@drawable/arrow_left"
                    android:tint="@color/forgot_text_primary" />

                <LinearLayout
                    android:id="@+id/defaultContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="24dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <FrameLayout
                            android:layout_width="44dp"
                            android:layout_height="44dp">

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/splash_logo_background" />

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_gravity="center"
                                android:contentDescription="@string/splash_logo_content_description"
                                android:src="@drawable/folder_open"
                                android:tint="@color/white" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-medium"
                                android:text="@string/splash_title"
                                android:textColor="@color/forgot_text_primary"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <ImageView
                                    android:layout_width="10dp"
                                    android:layout_height="10dp"
                                    android:src="@drawable/sparkles"
                                    android:tint="@color/splash_logo_end" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="4dp"
                                    android:text="@string/forgot_ai_powered"
                                    android:textColor="@color/splash_logo_end"
                                    android:textSize="11sp"
                                    android:textStyle="bold" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>

                    <FrameLayout
                        android:layout_width="136dp"
                        android:layout_height="136dp"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginBottom="20dp"
                        android:contentDescription="@string/forgot_secure_illustration">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:alpha="0.8"
                            android:background="@drawable/forgot_illustration_outer" />

                        <FrameLayout
                            android:layout_width="108dp"
                            android:layout_height="108dp"
                            android:layout_gravity="center"
                            android:background="@drawable/forgot_illustration_mid">

                            <FrameLayout
                                android:layout_width="80dp"
                                android:layout_height="80dp"
                                android:layout_gravity="center"
                                android:background="@drawable/forgot_illustration_inner">

                                <ImageView
                                    android:layout_width="40dp"
                                    android:layout_height="40dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/shield_check"
                                    android:tint="@color/forgot_blue" />
                            </FrameLayout>
                        </FrameLayout>

                        <View
                            android:layout_width="10dp"
                            android:layout_height="10dp"
                            android:layout_gravity="top|end"
                            android:layout_marginTop="14dp"
                            android:layout_marginEnd="12dp"
                            android:alpha="0.25"
                            android:background="@drawable/forgot_orbit_dot_blue" />

                        <View
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:layout_gravity="bottom|start"
                            android:layout_marginStart="10dp"
                            android:layout_marginBottom="16dp"
                            android:alpha="0.2"
                            android:background="@drawable/forgot_orbit_dot_purple" />

                        <View
                            android:layout_width="6dp"
                            android:layout_height="6dp"
                            android:layout_gravity="top|start"
                            android:layout_marginStart="18dp"
                            android:layout_marginTop="24dp"
                            android:alpha="0.15"
                            android:background="@drawable/forgot_orbit_dot_blue" />

                        <FrameLayout
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_gravity="top|end"
                            android:background="@drawable/splash_logo_background"
                            android:elevation="4dp">

                            <ImageView
                                android:layout_width="13dp"
                                android:layout_height="13dp"
                                android:layout_gravity="center"
                                android:src="@drawable/sparkles"
                                android:tint="@color/white" />
                        </FrameLayout>
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="@string/forgot_title"
                        android:textColor="@color/forgot_text_primary"
                        android:textSize="27sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="24dp"
                        android:lineSpacingExtra="3dp"
                        android:text="@string/forgot_subtitle"
                        android:textColor="@color/forgot_text_secondary"
                        android:textSize="14sp" />

                    <LinearLayout
                        android:id="@+id/emailFieldContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="42dp"
                            android:paddingStart="4dp"
                            android:paddingEnd="4dp"
                            android:text="@string/forgot_email_label"
                            android:textColor="@color/forgot_text_hint"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/emailInputLayout"
                            style="@style/ForgotTextInputLayout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="-4dp"
                            app:hintEnabled="false"
                            app:endIconTint="@color/forgot_green"
                            app:startIconDrawable="@drawable/mail"
                            app:startIconTint="@color/forgot_text_hint">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/emailEditText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:autofillHints="emailAddress"
                                android:hint="@string/forgot_email_placeholder"
                                android:inputType="textEmailAddress"
                                android:paddingTop="14dp"
                                android:paddingBottom="14dp"
                                android:textColor="@color/forgot_text_primary"
                                android:textColorHint="@color/forgot_text_hint" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="20dp"
                        android:gravity="top"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_marginTop="2dp"
                            android:background="@drawable/splash_badge_background"
                            android:gravity="center"
                            android:text="@string/forgot_toggle_info"
                            android:textColor="@color/forgot_text_hint"
                            android:textSize="10sp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:lineSpacingExtra="2dp"
                            android:text="@string/forgot_helper"
                            android:textColor="@color/forgot_text_hint"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/sendResetButton"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginBottom="16dp"
                        android:background="@drawable/auth_primary_button_background"
                        android:enabled="false"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="@string/forgot_send"
                        android:textAllCaps="false"
                        android:textColor="@color/auth_create_account_text"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        app:backgroundTint="@null"
                        app:icon="@drawable/send"
                        app:iconGravity="textStart"
                        app:iconPadding="10dp"
                        app:iconTint="@color/auth_create_account_text" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1"
                            android:background="#FFE6E0E9" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="12dp"
                            android:text="@string/login_or"
                            android:textColor="@color/forgot_border"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1"
                            android:background="#FFE6E0E9" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/backToLoginButton"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:background="@drawable/forgot_secondary_button"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="@string/forgot_back_to_login"
                        android:textAllCaps="false"
                        android:textColor="@color/forgot_blue"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:backgroundTint="@null"
                        app:icon="@drawable/arrow_left"
                        app:iconGravity="textStart"
                        app:iconPadding="8dp"
                        app:iconTint="@color/forgot_blue" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/otpContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <FrameLayout
                        android:layout_width="136dp"
                        android:layout_height="136dp"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginBottom="20dp"
                        android:contentDescription="@string/forgot_secure_illustration">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:alpha="0.8"
                            android:background="@drawable/forgot_illustration_outer" />

                        <FrameLayout
                            android:layout_width="108dp"
                            android:layout_height="108dp"
                            android:layout_gravity="center"
                            android:background="@drawable/forgot_illustration_mid">

                            <FrameLayout
                                android:layout_width="80dp"
                                android:layout_height="80dp"
                                android:layout_gravity="center"
                                android:background="@drawable/forgot_illustration_inner">

                                <ImageView
                                    android:layout_width="40dp"
                                    android:layout_height="40dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/shield_check"
                                    android:tint="@color/forgot_blue" />
                            </FrameLayout>
                        </FrameLayout>
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="@string/forgot_otp_title"
                        android:textColor="@color/forgot_text_primary"
                        android:textSize="27sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="24dp"
                        android:lineSpacingExtra="3dp"
                        android:text="@string/forgot_otp_subtitle"
                        android:textColor="@color/forgot_text_secondary"
                        android:textSize="14sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="24dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="42dp"
                            android:paddingStart="4dp"
                            android:paddingEnd="4dp"
                            android:text="@string/forgot_otp_label"
                            android:textColor="@color/forgot_text_hint"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/otpInputLayout"
                            style="@style/ForgotTextInputLayout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="-4dp"
                            app:hintEnabled="false"
                            app:startIconDrawable="@drawable/shield_check"
                            app:startIconTint="@color/forgot_text_hint">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/otpEditText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="@string/forgot_otp_placeholder"
                                android:inputType="numberPassword"
                                android:maxLength="6"
                                android:paddingTop="14dp"
                                android:paddingBottom="14dp"
                                android:textColor="@color/forgot_text_primary"
                                android:textColorHint="@color/forgot_text_hint" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/verifyOtpButton"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginBottom="16dp"
                        android:background="@drawable/auth_primary_button_background"
                        android:enabled="false"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="@string/forgot_verify_otp"
                        android:textAllCaps="false"
                        android:textColor="@color/auth_create_account_text"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        app:backgroundTint="@null"
                        app:icon="@drawable/check_circle"
                        app:iconGravity="textStart"
                        app:iconPadding="10dp"
                        app:iconTint="@color/auth_create_account_text" />
                        
                    <TextView
                        android:id="@+id/resendOtpText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackgroundBorderless"
                        android:padding="8dp"
                        android:text="@string/forgot_resend"
                        android:textColor="@color/splash_logo_end"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/newPasswordContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="@string/forgot_new_password_title"
                        android:textColor="@color/forgot_text_primary"
                        android:textSize="27sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="24dp"
                        android:lineSpacingExtra="3dp"
                        android:text="@string/forgot_new_password_subtitle"
                        android:textColor="@color/forgot_text_secondary"
                        android:textSize="14sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="42dp"
                            android:paddingStart="4dp"
                            android:paddingEnd="4dp"
                            android:text="@string/forgot_new_password_label"
                            android:textColor="@color/forgot_text_hint"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/newPasswordInputLayout"
                            style="@style/ForgotTextInputLayout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="-4dp"
                            app:hintEnabled="false"
                            app:passwordToggleEnabled="true"
                            app:passwordToggleTint="@color/forgot_text_hint"
                            app:startIconDrawable="@drawable/shield_check"
                            app:startIconTint="@color/forgot_text_hint">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/newPasswordEditText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="@string/forgot_new_password_placeholder"
                                android:inputType="textPassword"
                                android:paddingTop="14dp"
                                android:paddingBottom="14dp"
                                android:textColor="@color/forgot_text_primary"
                                android:textColorHint="@color/forgot_text_hint" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="24dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="42dp"
                            android:paddingStart="4dp"
                            android:paddingEnd="4dp"
                            android:text="@string/forgot_confirm_password_label"
                            android:textColor="@color/forgot_text_hint"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/confirmPasswordInputLayout"
                            style="@style/ForgotTextInputLayout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="-4dp"
                            app:hintEnabled="false"
                            app:passwordToggleEnabled="true"
                            app:passwordToggleTint="@color/forgot_text_hint"
                            app:startIconDrawable="@drawable/shield_check"
                            app:startIconTint="@color/forgot_text_hint">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/confirmPasswordEditText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="@string/forgot_confirm_password_placeholder"
                                android:inputType="textPassword"
                                android:paddingTop="14dp"
                                android:paddingBottom="14dp"
                                android:textColor="@color/forgot_text_primary"
                                android:textColorHint="@color/forgot_text_hint" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/resetPasswordButton"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginBottom="16dp"
                        android:background="@drawable/auth_primary_button_background"
                        android:enabled="false"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="@string/forgot_reset_password_button"
                        android:textAllCaps="false"
                        android:textColor="@color/auth_create_account_text"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        app:backgroundTint="@null"
                        app:iconGravity="textStart"
                        app:iconPadding="10dp"
                        app:iconTint="@color/auth_create_account_text" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/successContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <FrameLayout
                        android:layout_width="96dp"
                        android:layout_height="96dp"
                        android:layout_marginTop="72dp"
                        android:layout_marginBottom="24dp"
                        android:background="@drawable/forgot_email_chip">

                        <ImageView
                            android:layout_width="46dp"
                            android:layout_height="46dp"
                            android:layout_gravity="center"
                            android:src="@drawable/check_circle"
                            android:tint="@color/forgot_green" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:text="@string/forgot_check_inbox"
                        android:textColor="@color/forgot_text_primary"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/forgot_sent_prefix"
                        android:textColor="@color/forgot_text_secondary"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/sentEmailChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="28dp"
                        android:background="@drawable/forgot_email_chip"
                        android:paddingStart="16dp"
                        android:paddingTop="8dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="8dp"
                        android:textColor="@color/forgot_blue"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        tools:text="name@example.com" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="24dp"
                        android:background="@drawable/forgot_warning_background"
                        android:gravity="top"
                        android:orientation="horizontal"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📬"
                            android:textSize="18sp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:lineSpacingExtra="2dp"
                            android:text="@string/forgot_warning"
                            android:textColor="@color/forgot_warning_text"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/successBackButton"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:background="@drawable/auth_primary_button_background"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="@string/forgot_back_to_login"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:backgroundTint="@null"
                        app:icon="@drawable/arrow_left"
                        app:iconGravity="textStart"
                        app:iconPadding="8dp"
                        app:iconTint="@color/white" />

                    <TextView
                        android:id="@+id/resendLinkText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackgroundBorderless"
                        android:padding="4dp"
                        android:text="@string/forgot_resend"
                        android:textColor="@color/splash_logo_end"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
