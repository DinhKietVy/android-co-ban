<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="12dp"
    android:paddingEnd="24dp"
    android:paddingBottom="8dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/share_ttl_dialog_title"
        android:textColor="@color/profile_text_primary"
        android:textSize="14sp"
        android:textStyle="bold" />

    <RadioGroup
        android:id="@+id/rgLinkTtl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp">

        <RadioButton
            android:id="@+id/rbTtlNever"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="@string/share_ttl_never" />

        <RadioButton
            android:id="@+id/rbTtl1h"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/share_ttl_1h" />

        <RadioButton
            android:id="@+id/rbTtl7d"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/share_ttl_7d" />

        <RadioButton
            android:id="@+id/rbTtl30d"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/share_ttl_30d" />
    </RadioGroup>

    <com.google.android.material.textfield.TextInputLayout
        style="@style/AuthTextInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="@string/share_link_password_hint">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etLinkPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textPassword"
            android:maxLines="1"
            android:textSize="14sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/cbLinkOneTime"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/share_link_one_time"
        android:textSize="14sp" />

</LinearLayout>
