<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/explorer_bg"
    android:orientation="vertical">

    <!-- Top Bar -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:elevation="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="10dp">

        <ImageButton
            android:id="@+id/btnClose"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_cancel"
            android:src="@drawable/arrow_left"
            app:tint="@color/explorer_text_primary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/pdf_organizer_title"
                android:textColor="@color/explorer_text_primary"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvOrganizerSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/pdf_organizer_subtitle"
                android:textColor="@color/explorer_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnApply"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:backgroundTint="@color/explorer_primary"
            android:paddingHorizontal="16dp"
            android:text="@string/pdf_organizer_action_apply"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:textStyle="bold"
            app:cornerRadius="8dp" />
    </LinearLayout>

    <!-- Toolbar Actions Bar -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSelectAll"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:paddingHorizontal="12dp"
                android:text="@string/pdf_organizer_select_all"
                android:textAllCaps="false"
                android:textColor="@color/explorer_text_primary"
                android:textSize="12sp"
                app:cornerRadius="8dp"
                app:strokeColor="@color/explorer_border" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRotateSelected"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:paddingHorizontal="12dp"
                android:text="@string/pdf_organizer_action_rotate"
                android:textAllCaps="false"
                android:textColor="@color/explorer_text_primary"
                android:textSize="12sp"
                app:cornerRadius="8dp"
                app:icon="@drawable/rotate_ccw"
                app:iconSize="16dp"
                app:iconTint="@color/explorer_text_primary"
                app:strokeColor="@color/explorer_border" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDeleteSelected"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:paddingHorizontal="12dp"
                android:text="@string/pdf_organizer_action_delete"
                android:textAllCaps="false"
                android:textColor="#EF4444"
                android:textSize="12sp"
                app:cornerRadius="8dp"
                app:icon="@drawable/trash_2"
                app:iconSize="16dp"
                app:iconTint="#EF4444"
                app:strokeColor="#FCA5A5" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnExtractSelected"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:paddingHorizontal="12dp"
                android:text="@string/pdf_organizer_action_extract"
                android:textAllCaps="false"
                android:textColor="@color/explorer_primary"
                android:textSize="12sp"
                app:cornerRadius="8dp"
                app:icon="@drawable/copy"
                app:iconSize="16dp"
                app:iconTint="@color/explorer_primary"
                app:strokeColor="@color/explorer_primary" />

        </LinearLayout>
    </HorizontalScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/explorer_border" />

    <!-- Progress Indicator -->
    <ProgressBar
        android:id="@+id/progressOrganizer"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:indeterminate="true"
        android:visibility="gone" />

    <!-- Grid of Pages -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvPages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:padding="8dp" />

</LinearLayout>
