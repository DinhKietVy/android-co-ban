<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_marginBottom="4dp"
    android:background="@color/trash_surface"
    android:gravity="top"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="12dp"
    android:paddingEnd="8dp"
    android:paddingBottom="12dp">

    <ImageView
        android:id="@+id/selectButton"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:contentDescription="@string/trash_select_item"
        android:padding="6dp"
        app:tint="#99A1AF"
        tools:src="@drawable/circle" />

    <FrameLayout
        android:layout_width="48dp"
        android:layout_height="48dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/filePreviewImage"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/explorer_file_icon"
            android:scaleType="centerCrop"
            android:src="@drawable/explorer_file_preview_placeholder"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Explorer.FilePreview" />

        <ImageView
            android:id="@+id/fileFallbackIcon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:contentDescription="@string/explorer_file_icon"
            android:src="@drawable/file_text"
            android:tint="@color/explorer_primary"
            tools:visibility="visible" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/itemNameText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/trash_text_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="Receipt_Amazon_2026.jpg" />

        <TextView
            android:id="@+id/itemMetaText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/trash_text_secondary"
            android:textSize="13sp"
            tools:text="2.4 MB • image" />

        <LinearLayout
            android:id="@+id/tagContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/ocrPreviewText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/explorer_tag_background"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingStart="8dp"
            android:paddingTop="4dp"
            android:paddingEnd="8dp"
            android:paddingBottom="4dp"
            android:textColor="@color/trash_text_secondary"
            android:textSize="11sp"
            android:visibility="gone"
            tools:text="Amazon.com Order #123-4567890-123..."
            tools:visibility="visible" />

        <TextView
            android:id="@+id/deletedDateText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/trash_text_secondary"
            android:textSize="12sp"
            tools:text="Deleted 3 days ago" />

        <TextView
            android:id="@+id/removeInText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/trash_text_secondary"
            android:textSize="12sp"
            tools:text="Will be removed in 27 days" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/moreButton"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/trash_more"
        android:padding="8dp"
        android:src="@drawable/more_vertical"
        android:tint="@color/trash_text_secondary" />

</LinearLayout>
