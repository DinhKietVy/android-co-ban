<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="4dp"
    android:background="@color/trash_surface"
    android:gravity="top"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="12dp"
    android:paddingEnd="8dp"
    android:paddingBottom="12dp">

    <ImageButton
        android:id="@+id/selectButton"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/trash_select_item"
        android:padding="6dp"
        tools:src="@drawable/circle" />

    <FrameLayout
        android:id="@+id/thumbContainer"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="8dp"
        android:background="@color/recent_chip_bg">

        <ImageView
            android:id="@+id/thumbIcon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            tools:src="@drawable/file_text" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/itemNameText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/trash_text_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="Receipt_Amazon_2026.jpg" />

        <TextView
            android:id="@+id/itemMetaText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/trash_text_secondary"
            android:textSize="13sp"
            tools:text="2.4 MB • image" />

        <TextView
            android:id="@+id/ocrPreviewText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@color/recent_chip_bg"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingStart="8dp"
            android:paddingTop="6dp"
            android:paddingEnd="8dp"
            android:paddingBottom="6dp"
            android:textColor="@color/trash_text_secondary"
            android:textSize="12sp"
            android:visibility="gone"
            tools:text="Amazon.com Order #123-4567890-123..."
            tools:visibility="visible" />

        <LinearLayout
            android:id="@+id/tagContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/aiChipText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/explorer_tag_background"
                android:paddingStart="8dp"
                android:paddingTop="3dp"
                android:paddingEnd="8dp"
                android:paddingBottom="3dp"
                android:text="@string/recent_ai_analyzed"
                android:textColor="@color/splash_logo_end"
                android:textSize="11sp"
                android:visibility="gone"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/tagOneText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/explorer_tag_background"
                android:paddingStart="8dp"
                android:paddingTop="3dp"
                android:paddingEnd="8dp"
                android:paddingBottom="3dp"
                android:textColor="@color/recent_primary"
                android:textSize="11sp"
                android:visibility="gone"
                tools:text="Receipt"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/tagTwoText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/explorer_tag_background"
                android:paddingStart="8dp"
                android:paddingTop="3dp"
                android:paddingEnd="8dp"
                android:paddingBottom="3dp"
                android:textColor="@color/recent_primary"
                android:textSize="11sp"
                android:visibility="gone"
                tools:text="Invoice"
                tools:visibility="visible" />
        </LinearLayout>

        <TextView
            android:id="@+id/deletedDateText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/trash_text_secondary"
            android:textSize="12sp"
            tools:text="Deleted 3 days ago" />

        <TextView
            android:id="@+id/removeInText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/trash_text_secondary"
            android:textSize="12sp"
            tools:text="Will be removed in 27 days" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/moreButton"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/trash_more"
        android:padding="8dp"
        android:src="@drawable/more_vertical"
        android:tint="@color/trash_text_secondary" />

</LinearLayout>
