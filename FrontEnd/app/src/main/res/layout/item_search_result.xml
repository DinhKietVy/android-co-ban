<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@color/search_surface"
    android:orientation="horizontal"
    android:padding="16dp">

    <FrameLayout
        android:id="@+id/thumbContainer"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:background="@color/search_input_bg">

        <ImageView
            android:id="@+id/thumbIcon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center"
            tools:src="@drawable/file_text" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/fileNameText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/search_text_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="Invoice_March_2024.pdf" />

        <TextView
            android:id="@+id/fileMetaText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/search_text_secondary"
            android:textSize="13sp"
            tools:text="PDF • 2.4 MB • Mar 15, 2024" />

        <TextView
            android:id="@+id/ocrPreviewText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@color/search_input_bg"
            android:paddingStart="10dp"
            android:paddingTop="8dp"
            android:paddingEnd="10dp"
            android:paddingBottom="8dp"
            android:textColor="@color/search_text_primary"
            android:textSize="13sp"
            android:visibility="gone"
            tools:text="Total Amount: $1,249.00"
            tools:visibility="visible" />

        <LinearLayout
            android:id="@+id/tagContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tagOneText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/explorer_tag_background"
                android:paddingStart="8dp"
                android:paddingTop="4dp"
                android:paddingEnd="8dp"
                android:paddingBottom="4dp"
                android:textColor="@color/search_primary"
                android:textSize="11sp"
                tools:text="Invoice" />

            <TextView
                android:id="@+id/tagTwoText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/explorer_tag_background"
                android:paddingStart="8dp"
                android:paddingTop="4dp"
                android:paddingEnd="8dp"
                android:paddingBottom="4dp"
                android:textColor="@color/search_primary"
                android:textSize="11sp"
                tools:text="Receipt" />

            <TextView
                android:id="@+id/tagThreeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@color/search_primary_soft"
                android:paddingStart="8dp"
                android:paddingTop="4dp"
                android:paddingEnd="8dp"
                android:paddingBottom="4dp"
                android:textColor="@color/search_primary"
                android:textSize="11sp"
                tools:text="AI analyzed" />
        </LinearLayout>
    </LinearLayout>

    <ImageButton
        android:id="@+id/moreButton"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="8dp"
        android:src="@drawable/more_vertical"
        android:tint="@color/search_text_secondary" />

</LinearLayout>
