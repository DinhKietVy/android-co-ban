<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/recent_surface"
    android:gravity="top"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="12dp"
    android:paddingBottom="12dp">

    <FrameLayout
        android:id="@+id/thumbContainer"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@color/recent_chip_bg">

        <ImageView
            android:id="@+id/thumbIcon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            tools:src="@drawable/file_text" />

        <TextView
            android:id="@+id/thumbExt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="4dp"
            android:textColor="@color/recent_text_secondary"
            android:textSize="9sp"
            android:textStyle="bold"
            tools:text="PDF" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/itemNameText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/recent_text_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="Contract_NDA_2026.pdf" />

            <ImageView
                android:id="@+id/favoriteStarIcon"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginStart="6dp"
                android:src="@drawable/star"
                android:tint="#FFFBBC04"
                android:visibility="gone"
                tools:visibility="visible" />
        </LinearLayout>

        <TextView
            android:id="@+id/itemMetaText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/recent_text_secondary"
            android:textSize="12sp"
            tools:text="540 KB · Yesterday, 4:50 PM" />

        <TextView
            android:id="@+id/ocrSnippetText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/recent_text_secondary"
            android:textSize="12sp"
            android:textStyle="italic"
            android:visibility="gone"
            tools:text="Non-Disclosure Agreement — Effective May 20, 2026"
            tools:visibility="visible" />

        <LinearLayout
            android:id="@+id/tagContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/aiChipText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/explorer_tag_background"
                android:paddingStart="8dp"
                android:paddingTop="3dp"
                android:paddingEnd="8dp"
                android:paddingBottom="3dp"
                android:text="@string/recent_ai_analyzed"
                android:textColor="@color/recent_primary"
                android:textSize="11sp"
                android:visibility="gone"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/tagOneText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@color/recent_chip_bg"
                android:paddingStart="8dp"
                android:paddingTop="3dp"
                android:paddingEnd="8dp"
                android:paddingBottom="3dp"
                android:textColor="@color/recent_text_secondary"
                android:textSize="11sp"
                android:visibility="gone"
                tools:text="Contract"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/tagTwoText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@color/recent_chip_bg"
                android:paddingStart="8dp"
                android:paddingTop="3dp"
                android:paddingEnd="8dp"
                android:paddingBottom="3dp"
                android:textColor="@color/recent_text_secondary"
                android:textSize="11sp"
                android:visibility="gone"
                tools:text="Legal"
                tools:visibility="visible" />
        </LinearLayout>
    </LinearLayout>

    <ImageButton
        android:id="@+id/moreButton"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/explorer_more"
        android:padding="8dp"
        android:src="@drawable/more_vertical"
        android:tint="@color/recent_text_secondary" />

</LinearLayout>
