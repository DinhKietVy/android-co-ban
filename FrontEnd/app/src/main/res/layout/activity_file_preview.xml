<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/preview_bg"
    tools:context=".preview.FilePreviewActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/topAppBar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@color/preview_surface"
            android:elevation="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <ImageButton
                android:id="@+id/backButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/preview_back"
                android:padding="8dp"
                android:src="@drawable/arrow_left"
                android:tint="@color/preview_text_primary" />

            <TextView
                android:id="@+id/titleText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/preview_file_name"
                android:textColor="@color/preview_text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/moreButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/preview_more"
                android:padding="8dp"
                android:src="@drawable/more_vertical"
                android:tint="@color/preview_text_primary" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingBottom="120dp">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:minHeight="240dp"
                    app:cardElevation="1dp"
                    app:strokeColor="@color/preview_border"
                    app:strokeWidth="1dp">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:minHeight="240dp">

                        <ImageView
                            android:id="@+id/previewImage"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:adjustViewBounds="true"
                            android:contentDescription="@string/preview_file_name"
                            android:scaleType="fitCenter"
                            tools:src="@drawable/file_text" />

                        <androidx.media3.ui.PlayerView
                            android:id="@+id/previewVideo"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_gravity="center"
                            android:visibility="gone" />

                        <ScrollView
                            android:id="@+id/previewTextScroll"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:visibility="gone">
                            <EditText
                                android:id="@+id/previewText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:padding="16dp"
                                android:textColor="@color/preview_text_primary"
                                android:textSize="14sp"
                                android:fontFamily="monospace"
                                android:background="@null"
                                android:focusable="false"
                                android:cursorVisible="false"
                                android:inputType="textMultiLine|textNoSuggestions"
                                tools:text="Sample text content..." />
                        </ScrollView>

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/previewPdfRecycler"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:visibility="gone"
                            tools:listitem="@layout/item_pdf_page" />

                        <WebView
                            android:id="@+id/previewDocxWebView"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:visibility="gone" />

                        <LinearLayout
                            android:id="@+id/previewUnsupported"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="32dp"
                            android:visibility="gone">

                            <ImageView
                                android:id="@+id/unsupportedIcon"
                                android:layout_width="64dp"
                                android:layout_height="64dp"
                                android:src="@drawable/file_text"
                                android:tint="@color/preview_text_secondary" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="16dp"
                                android:text="@string/preview_unsupported_file"
                                android:textColor="@color/preview_text_primary"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/openExternallyButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="24dp"
                                android:text="@string/preview_open_externally"
                                app:icon="@drawable/external_link" />
                        </LinearLayout>

                        <ProgressBar
                            android:id="@+id/previewLoadingIndicator"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_gravity="center"
                            android:visibility="gone" />

                    </FrameLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <View
        android:id="@+id/scrimView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="@color/scrim_33"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/bottomSheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/preview_surface"
        android:elevation="12dp"
        android:orientation="vertical"
        android:paddingBottom="8dp"
        android:visibility="gone">

        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="8dp"
            android:background="@color/preview_border" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingTop="12dp"
            android:paddingEnd="20dp"
            android:paddingBottom="12dp">

            <ImageView
                android:id="@+id/sheetHeaderIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/info"
                android:tint="@color/preview_primary" />

            <TextView
                android:id="@+id/sheetTitleText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/preview_sheet_file_info"
                android:textColor="@color/preview_text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/closeSheetButton"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="8dp"
                android:src="@drawable/x_close"
                android:tint="@color/preview_text_secondary" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/preview_border" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="320dp"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="16dp"
                android:paddingEnd="20dp"
                android:paddingBottom="20dp">

                <LinearLayout
                    android:id="@+id/fileInfoContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <include layout="@layout/item_preview_info_name" />
                    <include layout="@layout/item_preview_info_type" />
                    <include layout="@layout/item_preview_info_size" />
                    <include layout="@layout/item_preview_info_uploaded" />
                    <include layout="@layout/item_preview_info_modified" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/aiAnalysisContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">



                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Show processed image"
                            android:textColor="@color/preview_text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/showProcessedImageSwitch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/preview_extracted_text"
                                android:textColor="@color/preview_text_primary"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/editOcrButton"
                                android:layout_width="wrap_content"
                                android:layout_height="36dp"
                                android:layout_marginEnd="8dp"
                                android:backgroundTint="@color/preview_surface"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:text="Edit"
                                android:textAllCaps="false"
                                android:textColor="@color/preview_primary"
                                android:textSize="12sp"
                                app:icon="@drawable/edit_3"
                                app:iconTint="@color/preview_primary" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/copyButton"
                                android:layout_width="wrap_content"
                                android:layout_height="36dp"
                                android:backgroundTint="@color/preview_accent"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:text="@string/preview_copy"
                                android:textAllCaps="false"
                                android:textColor="@color/preview_text_primary"
                                android:textSize="12sp"
                                app:icon="@drawable/copy"
                                app:iconTint="@color/preview_text_primary" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/ocrTextView"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:background="@color/preview_accent"
                            android:lineSpacingExtra="2dp"
                            android:padding="16dp"
                            android:textColor="@color/preview_text_primary"
                            android:textSize="14sp"
                            tools:text="INVOICE..." />
                    </LinearLayout>

                        <TextView
                            android:id="@+id/objectTagsTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="20dp"
                            android:text="@string/preview_detected_objects"
                        android:textColor="@color/preview_text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:id="@+id/objectTagsContainerLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="vertical">

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/objectTagsChipGroup"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/addTagButton"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:layout_marginTop="8dp"
                            android:backgroundTint="@color/preview_surface"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:text="Add Tag"
                            android:textAllCaps="false"
                            android:textColor="@color/preview_primary"
                            android:textSize="12sp"
                            app:icon="@drawable/plus"
                            app:iconTint="@color/preview_primary" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/footerBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/preview_surface"
        android:elevation="10dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingTop="10dp"
        android:paddingEnd="24dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:id="@+id/fileInfoTab"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="6dp"
            android:paddingEnd="16dp"
            android:paddingBottom="6dp">

            <FrameLayout
                android:layout_width="40dp"
                android:layout_height="40dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:tint="@color/preview_text_secondary"
                    android:src="@drawable/info" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/preview_file_info"
                android:textSize="12sp" />
        </LinearLayout>

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <LinearLayout
            android:id="@+id/aiAnalysisTab"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="6dp"
            android:paddingEnd="16dp"
            android:paddingBottom="6dp">

            <FrameLayout
                android:id="@+id/aiAnalysisIconBg"
                android:layout_width="40dp"
                android:layout_height="40dp">

                <ImageView
                    android:id="@+id/aiAnalysisIcon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/sparkles"
                    android:tint="@color/preview_text_secondary" />
            </FrameLayout>

            <TextView
                android:id="@+id/aiAnalysisLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/preview_ai_analysis"
                android:textColor="@color/preview_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/editFab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="90dp"
        android:src="@drawable/edit_3"
        android:visibility="gone"
        app:tint="@color/white"
        app:backgroundTint="@color/preview_primary" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
