<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
    <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/calendar" android:tint="@color/preview_text_secondary"/>
    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:text="@string/preview_info_modified" android:textColor="@color/preview_text_secondary" android:textSize="14sp"/>
    <TextView android:id="@+id/previewInfoModifiedValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/preview_modified_date" android:textColor="@color/preview_text_primary" android:textSize="14sp" android:textStyle="bold"/>
</LinearLayout>
