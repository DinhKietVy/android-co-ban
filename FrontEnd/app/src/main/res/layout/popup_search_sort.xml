<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="220dp"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/search_surface"
    app:cardCornerRadius="16dp"
    app:cardElevation="8dp"
    app:cardUseCompatPadding="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <!-- Sort by Name -->
        <LinearLayout
            android:id="@+id/menuSortName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/arrow_down_a_z"
                app:tint="@color/search_text_secondary" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="@string/search_sort_name"
                android:textColor="@color/search_text_primary"
                android:textSize="14sp" />

            <ImageView
                android:id="@+id/checkSortName"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/check"
                app:tint="@color/search_text_primary"
                tools:visibility="visible" />
        </LinearLayout>

        <!-- Sort by Date -->
        <LinearLayout
            android:id="@+id/menuSortDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/clock"
                app:tint="@color/search_text_secondary" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="@string/search_sort_date"
                android:textColor="@color/search_text_primary"
                android:textSize="14sp" />

            <ImageView
                android:id="@+id/checkSortDate"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/check"
                app:tint="@color/search_text_primary"
                android:visibility="invisible" />
        </LinearLayout>

        <!-- Sort by Size -->
        <LinearLayout
            android:id="@+id/menuSortSize"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/weight"
                app:tint="@color/search_text_secondary" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="@string/search_sort_size"
                android:textColor="@color/search_text_primary"
                android:textSize="14sp" />

            <ImageView
                android:id="@+id/checkSortSize"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/check"
                app:tint="@color/search_text_primary"
                android:visibility="invisible" />
        </LinearLayout>
    </LinearLayout>

</androidx.cardview.widget.CardView>
